{
  "name": "nest-docs-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "npm run sync:data && expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "npm run sync:data && expo start --web",
    "export:web": "npm run sync:data && expo export --platform web",
    "typecheck": "tsc --noEmit",
    "sync:data": "node scripts/split-data.mjs",
    "ios:device": "bash scripts/install-ios.sh"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.19",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}